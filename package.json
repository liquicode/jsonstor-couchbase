{
	"name": "@liquicode/jsonstor-couchbase",
	"version": "0.1.0",
	"description": "A jsonstor adapter which stores documents in a Couchbase bucket.",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"homepage": "http://jsonstor.liquicode.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/liquicode/jsonstor-couchbase"
	},
	"authors": [
		{
			"name": "Andre' G. Bowlin",
			"email": "agbowlin@gmail.com",
			"homepage": "http://liquicode.com"
		}
	],
	"type": "commonjs",
	"main": "src/jsonstor-couchbase.js",
	"types": "./types/jsonstor-couchbase.d.ts",
	"exports": {
		".": {
			"types": "./types/jsonstor-couchbase.d.ts",
			"import": "./src/jsonstor-couchbase.mjs",
			"require": "./src/jsonstor-couchbase.js",
			"default": "./src/jsonstor-couchbase.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"types",
		"license.md",
		"readme.md",
		"history.md"
	],
	"scripts": {
		"publish version": "npx @liquicode/devops --tasks .\\build\\devops.tasks.js publish_version",
		"start new version": "npx @liquicode/devops --tasks .\\build\\devops.tasks.js start_new_version"
	},
	"keywords": [
		"jsonstor",
		"couchbase",
		"n1ql",
		"sql++",
		"mongo query"
	],
	"devDependencies": {
		"@liquicode/devops": "^0.1.0"
	},
	"dependencies": {
		"@liquicode/jsongin": "^0.1.0",
		"@liquicode/jsonstor": "^0.1.0"
	}
}
